  },
  "claims": [
    {"claimId":"v2.p01.direct-one-settlement","statement":"Each action has one local witness, one local Groth16 proof, one wallet-owned funding input, and one BCH settlement transaction; batching, coordinators, sponsors, faucets, remote provers, preparation transactions, recursion, and root-history accumulators are forbidden.","category":"topology","severity":"critical","applicability":"all V2 Direct actions","assumptions":[],"obligationIds":["v2.p01.direct-one-settlement"]},
    {"claimId":"v2.p02.sks2-native-state","statement":"State is the exact 128-byte SKS2 CashToken commitment with canonical roots, counts, capacity, reserve, and sequence.","category":"encoding","severity":"critical","applicability":"all V2 Direct state","assumptions":[],"obligationIds":["v2.p02.sks2-native-state"]},
    {"claimId":"v2.p03.state-invariants","statement":"State counters, capacity, reserve equation, denomination, and overflow/underflow conditions hold for every transition.","category":"state","severity":"critical","applicability":"all V2 Direct transitions","assumptions":[],"obligationIds":["v2.p03.state-invariants"]},
    {"claimId":"v2.p04.profile-instance-identity","statement":"SKP2 profile identity and the descriptor bind the protocol profile, instance category, genesis, state, locks, base values, and artifact manifest without an identity cycle.","category":"identity","severity":"critical","applicability":"all V2 Direct instances","assumptions":[],"obligationIds":["v2.p04.profile-instance-identity"]},
    {"claimId":"v2.p05.sda2-packet","statement":"Every action uses the exact 552-byte SDA2 packet with full SHA-256 split into two unsigned big-endian u128 public inputs.","category":"encoding","severity":"critical","applicability":"all V2 Direct actions","assumptions":[],"obligationIds":["v2.p05.sda2-packet"]},
    {"claimId":"v2.p06.transition-conservation","statement":"Deposit, transfer, and withdrawal enforce exact roots, counters, reserve deltas, capacity, payout, and value conservation in circuit and covenant.","category":"transition","severity":"critical","applicability":"all V2 Direct actions","assumptions":[],"obligationIds":["v2.p06.transition-conservation"]},
    {"claimId":"v2.p07.note-privacy-crypto","statement":"Address, note, nullifier, encrypted record, subgroup, canonicality, Faerie-resistance, and secret-handling rules match the pinned V2 Direct domains and relation.","category":"cryptography","severity":"critical","applicability":"all V2 Direct notes and records","assumptions":["practical privacy remains conditioned on the documented threat model and live activity"],"obligationIds":["v2.p07.note-privacy-crypto"]},
    {"claimId":"v2.p08.persistent-trees","statement":"A depth-32 append-only note tree and depth-32 indexed nullifier tree provide canonical persistent witness data without rebuilding history or a historical-root accumulator.","category":"storage","severity":"critical","applicability":"all V2 Direct history","assumptions":[],"obligationIds":["v2.p08.persistent-trees"]},
    {"claimId":"v2.p09.pf10-rolling-topology","statement":"Operational V2 Direct uses only PF10-FusedQGenesis with exact ordered roles, category-bound rolling carriers, binding, state, and funding; PF11 is semantic-oracle-only.","category":"covenant","severity":"critical","applicability":"all operational V2 Direct settlements","assumptions":[],"obligationIds":["v2.p09.pf10-rolling-topology"]},
    {"claimId":"v2.p10.full-standard-caps","statement":"Every final settlement must satisfy complete standard limits: serialized transaction bytes <= 100000, every unlocking bytecode <= 10000 bytes, and every VM resource <= 100 percent. Narrower margins are telemetry only.","category":"resource","severity":"critical","applicability":"all final V2 Direct settlements","assumptions":[],"obligationIds":["v2.p10.full-standard-caps"]},
    {"claimId":"v2.p11.exact-context-binding","statement":"The packet, proof, binding covenant, and transaction context bind exact roles, outpoints, values, locks, token prefixes, and successor topology without circular transaction-id dependence.","category":"binding","severity":"critical","applicability":"all V2 Direct settlements","assumptions":[],"obligationIds":["v2.p11.exact-context-binding"]},
    {"claimId":"v2.p12.self-funded-wallet","statement":"One wallet-owned tokenless P2PKH UTXO funds each action, payout/change/fee rules are exact, and stale or unsafe funding is rejected before broadcast.","category":"wallet","severity":"high","applicability":"all V2 Direct actions","assumptions":[],"obligationIds":["v2.p12.self-funded-wallet"]},
    {"claimId":"v2.p13.durable-lifecycle","statement":"Prepare, prove, sign, broadcast, reconcile, recovery, reservations, reorg handling, and state commit are crash-safe and no send bypasses the mandatory network gate.","category":"durability","severity":"critical","applicability":"all V2 Direct operations","assumptions":[],"obligationIds":["v2.p13.durable-lifecycle"]},
    {"claimId":"v2.p14.bounded-beta-cli","statement":"The normal product surface is bounded and beta-labelled; low-level V2 controls are developer-only, secrets are local, and no sponsor or faucet is available.","category":"ux","severity":"high","applicability":"current beta product surface","assumptions":[],"obligationIds":["v2.p14.bounded-beta-cli"]},
    {"claimId":"v2.p15.version-network-refusal","statement":"V1 bytes/artifacts/state never migrate into V2 Direct, beta evidence never promotes itself, and V2 Direct mainnet operation is refused.","category":"scope","severity":"critical","applicability":"always","assumptions":[],"obligationIds":["v2.p15.version-network-refusal"]},
    {"claimId":"v2.a01.subject-spec-freeze","statement":"The 2ba14fd subject lock, V2 identifiers, domain registry, and legacy quarantine are reviewed as one immutable specification subject.","category":"phase-gate","severity":"critical","applicability":"before candidate freeze","assumptions":[],"obligationIds":["v2.a01.subject-spec-freeze"]},
    {"claimId":"v2.a02.independent-models","statement":"Codec, tree, arithmetic, and value models agree across independent implementation surfaces and frozen vectors.","category":"phase-gate","severity":"critical","applicability":"before candidate freeze","assumptions":[],"obligationIds":["v2.a02.independent-models"]},
    {"claimId":"v2.b01.candidate-freeze","statement":"The relation, packet ABI, topology, constraints, and development artifacts are independently reviewed and frozen before a setup is used for any final artifact.","category":"phase-gate","severity":"critical","applicability":"before final artifact production","assumptions":[],"obligationIds":["v2.b01.candidate-freeze"]},
    {"claimId":"v2.b02.final-vm-foundation","statement":"One final artifact root has matching maintainer benchmark, Libauth, BCHN mempool, mined BCHN, and LeanBCH evidence for the same final transactions.","category":"phase-gate","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.b02.final-vm-foundation"]},
    {"claimId":"v2.c01.product-operational-safety","statement":"Persistent storage, private local custody, recovery, locked dependencies, 0600 secrets, and no-bypass networking are qualified on the final artifact root.","category":"phase-gate","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.c01.product-operational-safety"]},
    {"claimId":"v2.d01.setup-trust-disclosed","statement":"Setup trust is separately disclosed, reproducible, and artifact-bound. A multiparty ceremony is an optional stronger trust profile, not an implicit prerequisite or inferred property.","category":"setup-trust","severity":"critical","applicability":"every proving key lineage","assumptions":[],"obligationIds":["v2.d01.setup-trust-disclosed"]},
    {"claimId":"v2.d02.independent-audits","statement":"Independent protocol/privacy, circuit/crypto/setup, covenant/topology, and wallet/recovery/network audits close every applicable critical, high, and medium finding before release.","category":"audit","severity":"critical","applicability":"release","assumptions":[],"obligationIds":["v2.d02.independent-audits"]},
    {"claimId":"v2.q01.final-artifact-replay","statement":"Final artifacts replay frozen codec, packet digest, relation, and topology semantics without substitution or source drift.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q01.final-artifact-replay"]},
    {"claimId":"v2.q02.final-proof-corpus","statement":"A final-key corpus covers deposit, transfer, and withdrawal bases and typed mutations against exact final transactions and independent VM lanes.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q02.final-proof-corpus"]},
    {"claimId":"v2.q03.covenant-attack-matrix","statement":"The selected final locks reject standalone burn, partial bundle, mixed parent, fake category, duplicate NFT, minting, omitted successor, role-count, and role-swap attacks.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q03.covenant-attack-matrix"]},
    {"claimId":"v2.q04.one-complete-100k-history","statement":"Exactly one deterministic, continuous 100000-action history is executed and independently replayed; aggregate shorter histories do not satisfy this obligation.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q04.one-complete-100k-history"]},
    {"claimId":"v2.q05.crypto-secret-safety","statement":"Final-profile crypto KATs, malformed/subgroup/Faerie/reuse cases, and secret-exposure controls are independently assessed.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q05.crypto-secret-safety"]},
    {"claimId":"v2.q06.fault-concurrency","statement":"Production-representative fault, restart, reorg, contention, and recovery campaigns preserve safety without premature commit or duplicate broadcast.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q06.fault-concurrency"]},
    {"claimId":"v2.q07.performance-and-full-history","statement":"Final published-machine evidence measures full caps, proving, memory, cold I/O, persistent tree work, and the one complete 100000-action history without using beta/local summaries as a substitute.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q07.performance-and-full-history"]},
    {"claimId":"v2.q08.clean-host-recovery","statement":"Two independent clean hosts install pinned final artifacts, fund, act, erase local state, recover, and spend a recovered note with independently replayed signed evidence.","category":"qualification","severity":"critical","applicability":"final artifact root only","assumptions":[],"obligationIds":["v2.q08.clean-host-recovery"]},
    {"claimId":"v2.q09.zero-conf-chipnet-coverage","statement":"A public Chipnet zero-confirmation live gate covers every required action and recovery/negative route with exact raw and successor-state observation; it is coverage-driven and has no 30-day or soak requirement.","category":"qualification","severity":"critical","applicability":"Chipnet only","assumptions":["public providers observe network metadata"],"obligationIds":["v2.q09.zero-conf-chipnet-coverage"]}
  ],
